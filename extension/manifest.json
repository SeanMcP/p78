{
  "manifest_version": 3,
  "name": "P78",
  "version": "1.0.0",
  "description": "Shows when the next PRT P78 bus arrives at your stop.",
  "permissions": [
    "alarms",
    "contextMenus",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "https://truetime.rideprt.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "P78",
    "default_icon": {
      "16": "icons/16.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
